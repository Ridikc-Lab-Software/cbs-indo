<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
	android:background="@drawable/info"
    tools:context=".data_member.data_member_activity_v2">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageView5"
            android:layout_width="150dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"
            android:background="@drawable/logo_user" />

        <TextView
            android:id="@+id/textView9"
            android:layout_width="match_parent"
            android:layout_gravity="center"
            android:textAlignment="center"
            android:textStyle="bold"
             android:textSize="20dp"
            android:textColor="#FFFFFF"
            android:layout_height="wrap_content"
            android:text="Member" />

        <TextView
            android:id="@+id/textView10"
            android:layout_width="match_parent"
            android:layout_gravity="center"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textSize="20dp"
            android:textColor="#FFFFFF"
            android:layout_height="wrap_content"
            android:text="Information" />





        <androidx.recyclerview.widget.RecyclerView

            android:id="@+id/data_member_tampil"
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:layout_marginLeft="7dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="7dp"
            android:clipToPadding="false"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingBottom="10dp"
            tools:listitem="@layout/data_member_tampil_v2">

        </androidx.recyclerview.widget.RecyclerView>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/infogif"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="7dp"
        android:layout_marginTop="90dp"
        android:layout_marginRight="7dp"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingBottom="10dp">

        <pl.droidsonroids.gif.GifImageView
            android:id="@+id/gif1"
            android:layout_width="match_parent"

            android:layout_height="185dp"
            android:src="@drawable/tidakadainternet"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.496"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.411"
            tools:ignore="MissingConstraints"
            tools:visibility="gone" />

        <pl.droidsonroids.gif.GifImageView
            android:id="@+id/gif2"
            app:layout_constraintBottom_toBottomOf="parent"
android:visibility="gone"
            app:layout_constraintHorizontal_bias="0.496"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.411"
            android:layout_width="match_parent"
            android:layout_height="185dp"
            android:src="@drawable/tidakadadata"
            tools:ignore="MissingConstraints" />

        <TextView
            android:id="@+id/text1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/gif1"
            android:gravity="center_horizontal"
            android:text="Tidak Ada Koneksi Internet"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textStyle="bold"
            tools:visibility="gone" />

        <TextView
            android:id="@+id/text2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/text1"
            android:layout_marginTop="10dp"
            android:gravity="center_horizontal"
            android:text="Silahkan Coba Lagi"
            android:textAlignment="center"
            android:textSize="12sp"
            tools:visibility="gone" />

    </RelativeLayout>

</RelativeLayout>


