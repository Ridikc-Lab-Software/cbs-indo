<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="5dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:padding="10dp"
        android:id="@+id/card1"
        android:layout_margin="10dp"
        app:cardCornerRadius="10dp"

        android:clickable="true"
        android:focusable="true"
        android:foreground="?selectableItemBackground"

        app:cardElevation="8dp"
        app:layout_columnWeight="1"

        app:layout_rowWeight="1"
        tools:ignore="OnClick"


        android:layout_height="wrap_content" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="12">

            <LinearLayout
                android:id="@+id/linearNomor"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/border_left_background_blue"
                android:gravity="center"
                android:visibility="gone">

                <TextView

                    android:id="@+id/txt_nomor"
                    android:layout_width="20dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:minHeight="50dp"
                    android:text=""
                    android:textSize="20dp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="10dp"
                android:layout_weight="9"
                android:orientation="vertical"
                android:padding="5dp">


                <TextView
                    android:id="@+id/id_member"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/img"
                    android:visibility="gone"
                    android:layout_width="113dp"
                    android:layout_height="102dp"
                    android:layout_gravity="center"
                    android:background="@drawable/logo"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/nama"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/id_member"
                    android:layout_gravity="center"
                    android:text="Fajarudin Sidik"
                    android:textColor="#329D9C"
                    android:textSize="19dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/alamat"
                    tools:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/nama" />

                <TextView
                    android:id="@+id/no_telepon"
                    tools:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/alamat" />

                <TextView
                    android:id="@+id/jenis_kelamin"
                    tools:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/no_telepon" />

                <TextView
                    android:id="@+id/tanggal_terdaftar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/jenis_kelamin"
                    android:layout_gravity="center"
                    tools:text=" 20 Januari 2020"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/id_kategori_member"
                    tools:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tanggal_terdaftar" />

                <TextView
                    android:id="@+id/kode_rfid"
                    tools:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/id_kategori_member" />



                <TextView
                    android:id="@+id/username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/point"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/username"
                    android:visibility="gone" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearEdit"
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:layout_weight="1"
                android:background="@color/grey"
                android:clickable="true"
                android:foreground="?selectableItemBackground"
                android:visibility="gone">

                <TextView

                    android:id="@+id/tombol_edit"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/color_edit"
                    android:gravity="center"
                    android:minWidth="60dp"
                    android:text="Edit"
                    android:textColor="@color/putih"
                    android:textSize="16dp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearHapus"
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="3dp"
                android:layout_marginRight="3dp"
                android:layout_marginBottom="3dp"
                android:layout_weight="1"
                android:background="@color/grey"
                android:clickable="true"
                android:foreground="?selectableItemBackground"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tombol_hapus"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@color/color_hapus"
                    android:gravity="center"
                    android:minWidth="60dp"
                    android:text="Hapus"
                    android:textColor="@color/putih"
                    android:textSize="16dp"
                    android:textStyle="bold" />

            </LinearLayout>


        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView

        android:layout_below="@+id/card1"
        android:layout_width="match_parent"
        android:padding="10dp"

        android:clickable="true"
        android:focusable="true"
        android:foreground="?selectableItemBackground"

        app:cardElevation="8dp"
        app:layout_columnWeight="1"

        app:layout_rowWeight="1"
        tools:ignore="OnClick"


        android:id="@+id/card2"
        android:layout_margin="10dp"
        app:cardCornerRadius="10dp"
        android:layout_height="152dp" >

        <LinearLayout
            android:id="@+id/linearBaris"
            android:layout_width="match_parent"
            android:layout_height="match_parent"


            android:orientation="vertical">
            <TextView
                android:id="@+id/test"
                android:layout_marginTop="35dp"
                 android:text="Jumlah Point "
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/no_telepon" />


            <TextView
                android:id="@+id/point"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/test"
                android:layout_gravity="center"
                android:text="200 poin"
                android:textSize="40dp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/test2"
                android:textColor="#329D9C"
                android:text="click to continue"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/point" />


        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>




