<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="5dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/id_member" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/id_member"
        android:id="@+id/nama" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/nama"
        android:id="@+id/alamat" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/alamat"
        android:id="@+id/no_telepon" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/no_telepon"
        android:id="@+id/jenis_kelamin" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/jenis_kelamin"
        android:id="@+id/tanggal_terdaftar" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tanggal_terdaftar"
        android:id="@+id/id_kategori_member" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/id_kategori_member"
        android:id="@+id/kode_rfid" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/kode_rfid"
        android:id="@+id/point" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/point"
        android:id="@+id/username" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/username"
        android:id="@+id/password" />


    <Button
        android:layout_below="@+id/foto_logo_bank"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:backgroundTint="@color/color_edit"
        android:textColor="#ffff"
        android:text="Edit"
        android:drawableLeft="@drawable/edit_putih"
        android:id="@+id/tombol_edit" />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:backgroundTint="@color/color_hapus"
        android:textColor="#ffff"
        android:text="Hapus"
        android:layout_toRightOf="@+id/tombol_edit"
        android:drawableLeft="@drawable/delete_putih"
        android:id="@+id/tombol_hapus" />

    <Button
        android:layout_below="@+id/no_telepon"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:backgroundTint="@color/color_tambah"
        android:textColor="#ffff"
        android:text="PILIH"
        android:drawableLeft="@drawable/tambah_putih"
        android:id="@+id/tombol_tambah" />

</RelativeLayout>




