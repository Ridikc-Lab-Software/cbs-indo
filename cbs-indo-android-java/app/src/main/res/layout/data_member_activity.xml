<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent"
    android:background="@drawable/background_data"
    tools:context=".data_member.data_member_activity">

    <LinearLayout
        android:id="@+id/atas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:ignore="MissingConstraints">

        <RelativeLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="7dp"
            android:layout_marginRight="20dp">

            <TextView
                android:id="@+id/a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data member"
                android:textColor="#ffff"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/a"
                android:layout_marginTop="6dp"
                android:text="Silahkan Input Data member"
                android:textColor="#ffff"
                android:textSize="14sp" />

            <Button
                android:visibility="gone"
                android:id="@+id/tombol_refresh"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_below="@id/b"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="7dp"
                android:background="@color/color_refresh"
                android:drawableLeft="@drawable/refresh_putih"
                android:text="Refresh"
                android:textAllCaps="false"
                android:textColor="#fff" />


            <ImageView
                android:visibility="gone"
                android:id="@+id/imageView4"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_alignParentRight="true"
                android:src="@drawable/page" />
        </RelativeLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp">


            <EditText
                android:background="@drawable/bg_search"
                android:id="@+id/search_data_member"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:hint="Cari No. Telp dan Nama"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tombol_cari_kanan"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/tombol_cari_kanan"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:layout_marginRight="8dp"
                android:background="@color/color_tambah"
                android:drawableLeft="@drawable/cari_putih"
                android:text="Cari"
                android:textAllCaps="false"
                android:textColor="#fff"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/search_data_member"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.106" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="6dp"
        android:layout_below="@+id/atas"
        android:indeterminateTint="@color/colorPrimary"
        android:indeterminate="true" />

    <!-- EMPTY STATE - TAMBAHAN BARU -->
    <LinearLayout
        android:id="@+id/empty_state_member"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/atas"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:background="@color/cardview_light_background"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="40dp"
        android:visibility="visible">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/user"
            android:alpha="0.3"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cari Data Member"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gunakan kolom pencarian di atas\nuntuk menemukan data member"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:lineSpacingExtra="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ketik No. Telepon atau Nama"
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:background="#F5F5F5"
            android:gravity="center"/>

    </LinearLayout>

    <ListView
        android:background="@color/cardview_light_background"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/atas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/data_member_tampil"
        android:visibility="gone">

    </ListView>


</RelativeLayout>