<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="5dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/id_promo"/>
	
	<TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/id_promo"
        android:id="@+id/tanggal_mulai_berlaku"/>
	<TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tanggal_mulai_berlaku"
        android:id="@+id/tanggal_batas_berlaku"/>
	<TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tanggal_batas_berlaku"
        android:id="@+id/nama_promo"/>
	<TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/nama_promo"
        android:id="@+id/keterangan"/>
	<TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/keterangan"
        android:id="@+id/syarat_dan_ketentuan"/>
	<TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/syarat_dan_ketentuan"
        android:id="@+id/foto_promo"/>
	<TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/foto_promo"
        android:id="@+id/jumlah_point"/>
	<TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/jumlah_point"
        android:id="@+id/status"/>
	


	<Button
        android:layout_below="@+id/foto_logo_bank"
        android:layout_width="wrap_content"
		android:layout_height="45dp"
		android:backgroundTint="@color/color_edit"
		android:textColor="#ffff"
        android:text="Edit"
		android:drawableLeft="@drawable/edit_putih"
        android:id="@+id/tombol_edit" />

    <Button
        android:layout_width="wrap_content"
		android:layout_height="45dp"
		android:backgroundTint="@color/color_hapus"
		android:textColor="#ffff"
        android:text="Hapus"
        android:layout_below="@+id/foto_logo_bank"
        android:layout_toRightOf="@+id/tombol_edit"
		android:drawableLeft="@drawable/delete_putih"
        android:id="@+id/tombol_hapus" />

</RelativeLayout>




