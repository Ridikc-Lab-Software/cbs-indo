<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
	android:background="@drawable/centre_background"
    tools:context=".data_kategori_member.data_kategori_member_tambah">

	<LinearLayout
		android:id="@+id/judul_Scrool"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		tools:ignore="MissingConstraints"
		tools:layout_editor_absoluteX="20dp">

		
		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="24dp"
			android:layout_marginLeft="15dp"
			android:textSize="15dp"
			android:textColor="@color/putih"
			android:text="TAMBAH"
			android:textStyle="bold" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="10dp"
			android:layout_marginLeft="15dp"
			android:textSize="15dp"
			android:textColor="@color/putih"
			android:text="Silahkan Input Data Dibawah ini"
			android:textStyle="bold" />

	</LinearLayout>

	<androidx.cardview.widget.CardView
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layout_marginTop="80dp"
		android:layout_marginRight="15dp"
		android:layout_marginLeft="15dp"
		android:layout_marginBottom="20dp"
		android:clickable="true"
		app:cardCornerRadius="8dp"
		app:cardElevation="8dp"
		app:layout_columnWeight="1"
		android:focusable="true"
		>


		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="vertical">


			<ScrollView


				android:layout_width="match_parent"
				android:layout_height="match_parent">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginLeft="10dp"
					android:orientation="vertical">

					<LinearLayout
						android:id="@+id/group"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal"
						android:weightSum="1">

						<LinearLayout
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="10dp"
							android:layout_marginRight="10dp"
							android:layout_marginBottom="5dp"
							android:layout_weight="1"
							android:orientation="vertical">

        
		
		
		<com.google.android.material.textfield.TextInputLayout
				android:visibility="gone"
                android:layout_width="match_parent"
                android:id="@+id/layout_id_kategori_member"
                android:layout_height="wrap_content">
                
        <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:id="@+id/id_kategori_member"
                    android:layout_height="wrap_content"
                    android:hint="Id kategori member" />
        </com.google.android.material.textfield.TextInputLayout>
		
		

		<com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
				android:layout_below="@+id/layout_id_kategori_member"
                android:id="@+id/layout_kategori_member"
				style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_height="wrap_content">
                
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:id="@+id/kategori_member"
                    android:layout_height="wrap_content"
					android:drawableLeft="@drawable/icon_email"
                    android:hint="Kategori member" />
			</com.google.android.material.textfield.TextInputLayout>
		<com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
				android:layout_below="@+id/layout_kategori_member"
                android:id="@+id/layout_gambar_logo"
				style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_height="wrap_content">
                
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:id="@+id/gambar_logo"
                    android:layout_height="wrap_content"
					android:drawableLeft="@drawable/icon_email"
                    android:hint="Gambar logo" />
			</com.google.android.material.textfield.TextInputLayout>
		



								<Button
								android:id="@+id/tombol_simpan"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginBottom="10dp"
								android:backgroundTint="@color/color_detail"
								android:drawableLeft="@drawable/simpan_putih"
								android:text="      SIMPAN     "
								android:textColor="#ffff"></Button>
					


					</LinearLayout>



					</LinearLayout>
				</LinearLayout>
			</ScrollView>
		</LinearLayout>
	</androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>






